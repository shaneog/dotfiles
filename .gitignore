# ssh
ssh/*
!ssh/config

# config
config/*
config/*/

# Tool state and generated config, ignored deliberately. Each entry needs a rule
# of its own rather than relying on the blanket lines above, so that a directory
# which is merely forgotten can be told apart from one that is meant to be
# absent -- see the classification test in test/static/lint.bats. Anything that
# should not be published goes in .git/info/exclude instead.
config/fish/
config/op/
config/pip/
config/toolhive/
config/uv/

# Starship
!config/starship.toml

# neovim
# lazy.nvim keeps plugins under stdpath("data"), so nothing it writes lands here
!config/nvim/

# tmux
!config/tmux/
config/tmux/plugins

# git
!config/git

# github
!config/gh

# homebrew
!config/homebrew
# runtime state: brew writes into $XDG_CONFIG_HOME/homebrew
config/homebrew/trust.json*

# karabiner
!config/karabiner

# mise
!config/mise

# zsh
!config/zsh/
config/zsh/.zcompdump
config/zsh/**/*.zwc*
# completion dump some setups write into ${ZDOTDIR}
config/zsh/.zcmpdump*
