#!/usr/bin/env bash
#
# Runs inside the throwaway VM, driven by test/vm/run. Installs the dotfiles the
# way a new machine does, then asserts what came out.
set -euo pipefail

GUEST_STARTED=$(date +%s)
PHASE_AT=$GUEST_STARTED
PHASE_NAME=""
TIMINGS="$HOME/vmtest/timings.txt"

say() {
  local now; now=$(date +%s)
  [ -n "$PHASE_NAME" ] && printf '%6ds  %s\n' "$((now - PHASE_AT))" "$PHASE_NAME" >> "$TIMINGS"
  PHASE_NAME="$*"; PHASE_AT=$now
  printf '\n--> %s\n' "$*"
}
die() { printf '\n!!! %s\n' "$*" >&2; exit 1; }

report_timings() {
  say "finished"
  printf '\n=== guest timings ===\n'
  cat "$TIMINGS"
  printf '%6ds  GUEST TOTAL\n' "$(( $(date +%s) - GUEST_STARTED ))"
  # bootstrap logs its own phases, so timestamping its output breaks down where
  # the time inside it actually went
  if [ -s "$HOME/vmtest/bootstrap.log" ]; then
    printf '\n=== inside script/bootstrap ===\n'
    awk '/^[0-9]+ --> / {
           if (prev_t) printf "%6ds  %s\n", $1 - prev_t, prev_m
           prev_t = $1; $1 = ""; prev_m = $0
         }
         END { if (prev_t) printf "%6ds  %s (to end)\n", ts - prev_t, prev_m }' \
      ts="$(date +%s)" "$HOME/vmtest/bootstrap.log"
  fi
}
trap report_timings EXIT

SRC="$HOME/dotfiles-src"
[ -d "$SRC" ] || die "no source tree at $SRC"

# bootstrap needs sudo without a terminal to type into. It already supports an
# askpass helper, so use its own hook rather than editing sudoers.
ASKPASS="$HOME/vmtest/askpass"
printf '#!/bin/sh\necho "%s"\n' "${VM_PASS:-admin}" > "$ASKPASS"
chmod 700 "$ASKPASS"
export SUDO_ASKPASS="$ASKPASS"

say "no Homebrew here yet, as on any new machine"
if command -v brew >/dev/null 2>&1; then die "Homebrew is already installed"; fi

say "running script/bootstrap"
# Installs from the copied tree instead of the default branch, so this exercises
# the code in front of us.
mkdir -p "$HOME/vmtest"
# Stamp only bootstrap's own phase markers. systime() is a gawk extension and a
# fresh macOS has BSD awk, and stamping every line would fork date thousands of
# times during the Homebrew install.
stamp_markers() {
  while IFS= read -r line; do
    case "$line" in
      "--> "*) printf '%s %s\n' "$(date +%s)" "$line" ;;
      *)       printf '    %s\n' "$line" ;;
    esac
  done
}
DOTFILES_URL="$SRC" "$SRC/script/bootstrap" 2>&1 \
  | stamp_markers \
  | tee "$HOME/vmtest/bootstrap.log"

say "Homebrew was installed from scratch"
[ -x /opt/homebrew/bin/brew ] || die "bootstrap did not install Homebrew"
eval "$(/opt/homebrew/bin/brew shellenv)"

say "the dotfiles were cloned and linked from ~/.dotfiles"
[ -d "$HOME/.dotfiles/.git" ] || die "nothing was cloned to ~/.dotfiles"
[ "$HOME/.zshenv"   -ef "$HOME/.dotfiles/config/zsh/.zshenv" ] || die ".zshenv is wrong"
[ "$HOME/.config"   -ef "$HOME/.dotfiles/config" ]             || die ".config is wrong"
[ "$HOME/.Brewfile" -ef "$HOME/.dotfiles/Brewfile" ]           || die ".Brewfile is wrong"

say "the Brewfile's formulae are installed"
for f in starship fzf direnv tmux neovim bats-core; do
  brew list --formula --versions "$f" >/dev/null 2>&1 || die "$f was not installed"
done

say "the macOS defaults were applied"
[ "$(defaults read com.apple.dock tilesize)" = "48" ] || die "script/macos did not apply"

say "a first login shell is fully wired"
probe='print "starship=$+functions[prompt_starship_precmd] direnv=$+functions[_direnv_hook] fzf=$+functions[fzf-file-widget] dump=$([[ -s $ZSH_COMPDUMP ]] && print yes || print no)"'
out="$(TERM=xterm-256color ZSH_NO_TMUX_AUTOSTART=1 zsh -lic "$probe")"
echo "    $out"
case "$out" in
  *"starship=1 direnv=1 fzf=1 dump=yes"*) ;;
  *) die "the shell came up incomplete" ;;
esac

# Asserting that after-setup and the tmux config *worked*, not merely that they
# ran. after-setup hung indefinitely on a fresh machine until recently, and CI
# reported it green throughout.
say "neovim plugins and parsers were actually installed"
lazy="$HOME/.local/share/nvim/lazy"
nvim_count="$(find "$lazy" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
[ "${nvim_count:-0}" -ge 5 ] || die "after-setup ran but installed no plugins"
echo "    $nvim_count plugins"
# Parsers are the half that fails quietly: without tree-sitter-cli, install()
# reports success and builds nothing, and highlighting simply never happens.
parsers="$HOME/.local/share/nvim/site/parser"
parser_count="$(find "$parsers" -name '*.so' 2>/dev/null | wc -l | tr -d ' ')"
[ "${parser_count:-0}" -ge 10 ] || die "after-setup installed $parser_count treesitter parsers"
echo "    $parser_count treesitter parsers"

say "tmux bootstraps its own plugins on first start"
tmux -f "$HOME/.config/tmux/tmux.conf" new-session -d -s probe
tmux_count=0
for _ in $(seq 1 60); do
  tmux_count="$(find "$HOME/.config/tmux/plugins" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  [ "${tmux_count:-0}" -ge 4 ] && break
  sleep 2
done
[ "${tmux_count:-0}" -ge 4 ] \
  || die "tmux installed $tmux_count plugin directories, expected tpm plus the configured ones"
echo "    $tmux_count plugin directories"

# The prefix plugin works by interpolating over #{prefix_highlight} in
# status-left. A stub tpm cannot show that, so it is asserted here, where the
# real plugin is installed: the placeholder must be gone and the three states
# it reports must be present.
status_left="$(tmux show -gv status-left 2>/dev/null || true)"
tmux kill-server 2>/dev/null || true
case "$status_left" in
  *'#{prefix_highlight}'*) die "the prefix plugin never interpolated status-left" ;;
esac
for state in client_prefix pane_in_mode synchronize-panes '#{prefix}'; do
  case "$status_left" in
    *"$state"*) ;;
    *) die "status-left is missing the $state indicator" ;;
  esac
done
echo "    the prefix indicator reports the live prefix key, copy and sync"

say "a second login shell is silent"
TERM=xterm-256color ZSH_NO_TMUX_AUTOSTART=1 zsh -lic 'true' 2>"$HOME/vmtest/second.err"
noise="$(grep -v "can't change option: zle" "$HOME/vmtest/second.err" | grep '[[:alpha:]]' || true)"
[ -z "$noise" ] || die "unexpected stderr on a settled machine: $noise"

if [ -n "${VM_RUN_SUITE:-}" ]; then
  say "running the bats suite on a pristine machine"
  cd "$HOME/.dotfiles"
  /bin/bash "$(command -v bats)" test/static test/unit test/integration
fi

say "guest assertions passed"
