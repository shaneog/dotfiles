#!/usr/bin/env bash
#
# Remove these dotfiles.
#
# By default this undoes what this repo installed and nothing else: the symlinks
# in $HOME, the clone at ~/.dotfiles, the caches its shell config generates, and
# the login shell that script/macos changed. Homebrew, everything the Brewfile
# installed, and the Command Line Tools are left alone: taking those out is a
# good deal more than "remove these dotfiles" promises.
#
#   script/remove               the dotfiles
#   script/remove --everything  ...and Homebrew, its packages, and the CLT
#
# Not undone either way: the settings script/macos wrote, because their previous
# values are recorded nowhere. Shell history under $XDG_DATA_HOME/zsh is also
# left alone, being yours rather than ours.
set -e -o pipefail

DEBUG=""
EVERYTHING=""
for arg in "$@"; do
  case "$arg" in
    --debug)      DEBUG="1" ;;
    --everything) EVERYTHING="1" ;;
    *) echo "!!! unknown option: $arg" >&2; exit 1 ;;
  esac
done
[[ -o xtrace ]] && DEBUG="1"

sudo_askpass() {
  if [ -n "$SUDO_ASKPASS" ]; then
    sudo --askpass "$@"
  else
    sudo "$@"
  fi
}

cleanup() {
  set +e
  sudo_askpass rm -rf "$SUDO_ASKPASS" "$SUDO_ASKPASS_DIR"
  sudo --reset-timestamp
}

trap "cleanup" EXIT

if [ -n "$DEBUG" ]; then
  set -x
fi

# We want to always prompt for sudo password at least once rather than doing
# root stuff unexpectedly.
sudo --reset-timestamp

# functions for turning off debug for use when handling the user password
clear_debug() {
  set +x
}

reset_debug() {
  if [ -n "$DEBUG" ]; then
    set -x
  fi
}

# Initialise (or reinitialise) sudo to save unhelpful prompts later.
sudo_init() {
  local SUDO_PASSWORD SUDO_PASSWORD_SCRIPT

  if ! sudo --validate --non-interactive &>/dev/null; then
    while true; do
      read -rsp "--> Enter your password (for sudo access):" SUDO_PASSWORD
      echo
      if sudo --validate --stdin 2>/dev/null <<<"$SUDO_PASSWORD"; then
        break
      fi

      unset SUDO_PASSWORD
      echo "!!! Wrong password!" >&2
    done

    clear_debug
    SUDO_PASSWORD_SCRIPT="$(cat <<BASH
#!/bin/bash
echo "$SUDO_PASSWORD"
BASH
)"
    unset SUDO_PASSWORD
    SUDO_ASKPASS_DIR="$(mktemp -d)"
    SUDO_ASKPASS="$(mktemp "$SUDO_ASKPASS_DIR"/remove-askpass-XXXXXXXX)"
    chmod 700 "$SUDO_ASKPASS_DIR" "$SUDO_ASKPASS"
    bash -c "cat > '$SUDO_ASKPASS'" <<<"$SUDO_PASSWORD_SCRIPT"
    unset SUDO_PASSWORD_SCRIPT
    reset_debug

    export SUDO_ASKPASS
  fi
}

sudo_refresh() {
  clear_debug
  if [ -n "$SUDO_ASKPASS" ]; then
    sudo --askpass --validate
  else
    sudo_init
  fi
  reset_debug
}

abort() { echo "!!! $*" >&2; exit 1; }
log()   { sudo_refresh; echo "--> $*"; }
logn()  { sudo_refresh; printf -- "--> %s " "$*"; }
logk()  { echo "OK"; }


[ "$USER" = "root" ] && abort "Run bootstrap as yourself, not root."
groups | grep -qE "\b(admin)\b" || abort "Add $USER to the admin group."

# Prevent sleeping during script execution, as long as the machine is on AC power
caffeinate -s -w $$ &

echo "This removes these dotfiles: the symlinks in \$HOME, the clone at"
echo "\$HOME/.dotfiles, the caches the shell config generates, and the login"
echo "shell that script/macos set."
if [ -n "$EVERYTHING" ]; then
  echo
  echo "--everything was given, so this will ALSO uninstall Homebrew, every"
  echo "package the Brewfile installed, and the Command Line Tools."
fi
echo
echo "Left alone either way: the macOS settings script/macos wrote, and your"
echo "shell history."
echo

read -r -p "Are you sure? [y/N] " response
if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  echo "Nothing done."
  exit 0
fi

echo "Please remove the added themes from Terminal.app manually."

# script/macos changed this, so it is ours to put back.
log "Restoring the login shell"
sudo_askpass dscl . -create "/Users/$USER" UserShell "/bin/zsh"

log "Removing the caches this config generates"
rm -rf "$HOME/.Brewfile.lock.json"
rm -rf "${XDG_DATA_HOME:-$HOME/.local/share}/zinit"
for cache in zsh zinit prezto fsh starship; do
  rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/$cache"
done

log "Removing the clone and the links into it"
rm -rf "$HOME/.dotfiles"
# Deleting the clone leaves every symlink into it dangling, which is what makes
# them safe to collect without a list of what was installed.
find "$HOME" -maxdepth 1 -type l ! -exec test -e {} \; -delete

if [ -n "$EVERYTHING" ]; then
  if [ -d "$(xcode-select -p)" ]; then
    log "Removing the Command Line Tools"
    sudo rm -rf "$(xcode-select -p)"
  fi

  log "Uninstalling everything Homebrew installed"
  formulae="$(brew list --formula || true)"
  # shellcheck disable=SC2086
  [ -n "$formulae" ] && brew uninstall --formula --force --ignore-dependencies $formulae || true
  casks="$(brew list --cask || true)"
  # shellcheck disable=SC2086
  [ -n "$casks" ] && brew uninstall --cask --force --ignore-dependencies $casks || true

  log "Uninstalling Homebrew"
  curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh | bash -s -- --force
  [ -d "/opt/homebrew" ] && sudo rm -rf /opt/homebrew
fi

echo "Done."
