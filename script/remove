#!/usr/bin/env bash
#
# Remove these dotfiles.
#
# By default this undoes what this repo installed and nothing else: the symlinks
# in $HOME, ~/.config, ~/.ssh and ~/.claude, the clone at ~/.dotfiles, the
# caches its shell config generates, and the login shell that script/bootstrap
# changed. Homebrew,
# everything the Brewfile installed, and the Command Line Tools are left alone:
# taking those out is a good deal more than "remove these dotfiles" promises.
#
#   script/remove               the dotfiles
#   script/remove --everything  ...and Homebrew, its packages, and the CLT
#
# Not undone either way: the settings script/macos wrote, because their previous
# values are recorded nowhere. Shell history under $XDG_DATA_HOME/zsh is also
# left alone, being yours rather than ours, and so is everything in ~/.config,
# ~/.ssh and ~/.claude that is not a link into the clone.
#
# What a tool wrote inside a directory that is linked into the clone does go
# with it: gh's record of the logged-in account, Homebrew's tap trust.
set -e -o pipefail

DEBUG=""
EVERYTHING=""
for arg in "$@"; do
  case "$arg" in
    --debug)      DEBUG="1" ;;
    --everything) EVERYTHING="1" ;;
    *) echo "!!! unknown option: $arg" >&2; exit 1 ;;
  esac
done
[[ -o xtrace ]] && DEBUG="1"

sudo_askpass() {
  if [ -n "$SUDO_ASKPASS" ]; then
    sudo --askpass "$@"
  else
    sudo "$@"
  fi
}

cleanup() {
  set +e
  sudo_askpass rm -rf "$SUDO_ASKPASS" "$SUDO_ASKPASS_DIR"
  sudo --reset-timestamp
}

trap "cleanup" EXIT

if [ -n "$DEBUG" ]; then
  set -x
fi

# We want to always prompt for sudo password at least once rather than doing
# root stuff unexpectedly.
sudo --reset-timestamp

# functions for turning off debug for use when handling the user password
clear_debug() {
  set +x
}

reset_debug() {
  if [ -n "$DEBUG" ]; then
    set -x
  fi
}

# Write the helper sudo calls to get the password, and the password beside it.
#
# The password is kept as data the helper prints, never pasted into the
# helper's own text: inside a script even quoted text is still shell, so a
# password containing $, ", \ or a backtick would be expanded when the helper
# ran -- handing sudo the wrong password, and running whatever sat between the
# backticks. The helper finds the file through its own $0, so no path is pasted
# into it either.
write_askpass() {  # helper path, password
  ( umask 077; printf '%s\n' "$2" > "$1.secret" )
  printf '#!/bin/bash\ncat "$0.secret"\n' > "$1"
}

# Initialise (or reinitialise) sudo to save unhelpful prompts later.
sudo_init() {
  local SUDO_PASSWORD

  if ! sudo --validate --non-interactive &>/dev/null; then
    while true; do
      read -rsp "--> Enter your password (for sudo access):" SUDO_PASSWORD
      echo
      if sudo --validate --stdin 2>/dev/null <<<"$SUDO_PASSWORD"; then
        break
      fi

      unset SUDO_PASSWORD
      echo "!!! Wrong password!" >&2
    done

    clear_debug
    SUDO_ASKPASS_DIR="$(mktemp -d)"
    SUDO_ASKPASS="$(mktemp "$SUDO_ASKPASS_DIR"/remove-askpass-XXXXXXXX)"
    chmod 700 "$SUDO_ASKPASS_DIR" "$SUDO_ASKPASS"
    write_askpass "$SUDO_ASKPASS" "$SUDO_PASSWORD"
    unset SUDO_PASSWORD
    reset_debug

    export SUDO_ASKPASS
  fi
}

sudo_refresh() {
  clear_debug
  if [ -n "$SUDO_ASKPASS" ]; then
    sudo --askpass --validate
  else
    sudo_init
  fi
  reset_debug
}

abort() { echo "!!! $*" >&2; exit 1; }
log()   { sudo_refresh; echo "--> $*"; }
logn()  { sudo_refresh; printf -- "--> %s " "$*"; }
logk()  { echo "OK"; }


# The Command Line Tools' directory, and nothing else. `xcode-select -p` names
# whichever developer directory is active, and with the full Xcode selected that
# is inside Xcode.app -- which --everything never offered to delete.
command_line_tools_dir() {
  local dir
  dir="$(xcode-select -p 2>/dev/null)" || return 1
  [ "$dir" = "/Library/Developer/CommandLineTools" ] || return 1
  echo "$dir"
}

[ "$USER" = "root" ] && abort "Run bootstrap as yourself, not root."
groups | grep -qE "\b(admin)\b" || abort "Add $USER to the admin group."

# A home set up by an older script/setup has ~/.config and ~/.ssh as links to
# the clone's whole directories, so everything any tool keeps under them is
# inside the clone and would be deleted with it. script/setup moves those files
# out; until it has, there is no safe way to remove the clone.
for dir in config ssh; do
  if [ -L "$HOME/.$dir" ] && [ "$HOME/.$dir" -ef "$HOME/.dotfiles/$dir" ]; then
    abort "$HOME/.$dir is a link to the whole of $HOME/.dotfiles/$dir, so removing" \
      "the clone would delete every other tool's files under it. Run" \
      "$HOME/.dotfiles/script/setup first, which moves them out, then this again."
  fi
done

# Prevent sleeping during script execution, as long as the machine is on AC power
caffeinate -s -w $$ &

echo "This removes these dotfiles: the symlinks in \$HOME, \$HOME/.config,"
echo "\$HOME/.ssh and \$HOME/.claude, the clone at \$HOME/.dotfiles, the caches"
echo "the shell config generates, and the login shell that script/bootstrap set."
if [ -n "$EVERYTHING" ]; then
  echo
  echo "--everything was given, so this will ALSO uninstall Homebrew, every"
  echo "package the Brewfile installed, and the Command Line Tools."
fi
echo
echo "Left alone either way: the macOS settings script/macos wrote, your shell"
echo "history, other tools' files under \$HOME/.config and \$HOME/.ssh, and"
echo "everything Claude Code keeps in \$HOME/.claude."
echo

read -r -p "Are you sure? [y/N] " response
if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
  echo "Nothing done."
  exit 0
fi

echo "Please remove the added themes from Terminal.app manually."

# script/bootstrap changed this, so it is ours to put back.
log "Restoring the login shell"
sudo_askpass dscl . -create "/Users/$USER" UserShell "/bin/zsh"

log "Removing the caches this config generates"
rm -rf "$HOME/.Brewfile.lock.json"
# zinit, prezto and fsh are from before the plugins were Homebrew formulae. A
# machine set up then still has them.
rm -rf "${XDG_DATA_HOME:-$HOME/.local/share}/zinit"
for cache in zsh zinit prezto fsh starship; do
  rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/$cache"
done

log "Removing the clone and the links into it"
# The links that resolve now and stop resolving once the clone is gone, which is
# what makes them ours without a list of what was installed. One that is
# already dangling -- pointing at a volume that is not mounted, say -- is
# somebody else's, and is left alone. Four places to look, because those are
# the four script/setup links into, and in ~/.claude one level further down,
# where a skill or an agent is a link inside a real folder.
live_links=()
for link in "$HOME"/.* "$HOME"/* \
            "$HOME"/.config/.* "$HOME"/.config/* \
            "$HOME"/.ssh/.* "$HOME"/.ssh/* \
            "$HOME"/.claude/.* "$HOME"/.claude/* "$HOME"/.claude/*/*; do
  if [ -L "$link" ] && [ -e "$link" ]; then
    live_links+=("$link")
  fi
done
rm -rf "$HOME/.dotfiles"
for link in "${live_links[@]}"; do
  [ -e "$link" ] || rm -f "$link"
done

if [ -n "$EVERYTHING" ]; then
  if clt="$(command_line_tools_dir)" && [ -d "$clt" ]; then
    log "Removing the Command Line Tools"
    sudo rm -rf "$clt"
  else
    log "Leaving the developer directory alone: it is not the Command Line Tools"
  fi

  log "Uninstalling everything Homebrew installed"
  formulae="$(brew list --formula || true)"
  # shellcheck disable=SC2086
  [ -n "$formulae" ] && brew uninstall --formula --force --ignore-dependencies $formulae || true
  casks="$(brew list --cask || true)"
  # shellcheck disable=SC2086
  [ -n "$casks" ] && brew uninstall --cask --force --ignore-dependencies $casks || true

  log "Uninstalling Homebrew"
  curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh | bash -s -- --force
  [ -d "/opt/homebrew" ] && sudo rm -rf /opt/homebrew
fi

echo "Done."
