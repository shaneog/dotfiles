#!/usr/bin/env bash
#
# macOS system settings. Run by script/bootstrap on a new machine, and safe to
# re-run afterwards -- every change is a `defaults write`, so it is idempotent.
#
# Deliberately no `set -e`: a key that a future macOS stops honouring should not
# stop the rest from applying. That means the exit status says little, so the
# provision workflow asserts a sample of the results with `defaults read`.
#
# Two things worth knowing before re-running on a machine you have since set up
# by hand:
#
#   - the Dock's icons are wiped (see persistent-apps below)
#   - the login shell is set to Homebrew's zsh
#
# Settings marked (relaunch) need the owning app restarted, which the killall at
# the bottom handles. Settings marked (logout) need a full logout or restart.

# Close System Settings, so an open pane cannot write its cached values back
# over what we are about to change. Called "System Preferences" until Ventura
# renamed it; the old name no longer resolves to anything.
osascript -e 'tell application "System Settings" to quit' 2>/dev/null

# Use Homebrew's zsh as the login shell, rather than the older one macOS ships.
#
# Guarded because bootstrap runs this script *before* the Brewfile installs zsh,
# so on a genuinely new machine the binary does not exist yet -- and pointing a
# login shell at a missing binary is how you end up unable to open a terminal.
# Re-running bootstrap once the Brewfile has been applied picks it up.
#
# Registered in /etc/shells and set with chsh rather than written straight into
# the directory with dscl: chsh validates the shell, and some tools check that
# list before trusting a shell.
brew_zsh="$(brew --prefix)/bin/zsh"
current_shell="$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')"
if [ ! -x "$brew_zsh" ]; then
	echo "Skipping login shell: $brew_zsh is not installed yet (the Brewfile installs it)"
elif [ "$current_shell" = "$brew_zsh" ]; then
	echo "Login shell is already $brew_zsh"
else
	echo "Using Homebrew's zsh for the login shell:"
	grep -qxF "$brew_zsh" /etc/shells || echo "$brew_zsh" | sudo tee -a /etc/shells >/dev/null
	sudo chsh -s "$brew_zsh" "$USER"
fi

###############################################################################
# General UI/UX                                                               #
###############################################################################

# Use Dark mode permanently (logout). Note that if appearance has ever been set
# to "Auto", AppleInterfaceStyleSwitchesAutomatically wins over this, and would
# need deleting as well.
defaults write NSGlobalDomain AppleInterfaceStyle -string "Dark"

# Expand save panel by default
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true

# Expand print panel by default
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true

# Automatically quit printer app once the print jobs complete
defaults write com.apple.print.PrintingPrefs "Quit When Finished" -bool true

###############################################################################
# Dock                                                                        #
###############################################################################

# Set the icon size of Dock items to 48 pixels
defaults write com.apple.dock tilesize -int 48

# Set the dock to the right side of the screen
defaults write com.apple.dock orientation -string "right"

# Wipe all app icons from the Dock (relaunch). This is why re-running bootstrap
# on an established machine costs you whatever you have pinned since.
defaults write com.apple.dock persistent-apps -array

# Show only open applications in the Dock
# defaults write com.apple.dock static-only -bool false

# Remove the auto-hiding Dock delay
defaults write com.apple.dock autohide-delay -float 0
# Remove the animation when hiding/showing the Dock
defaults write com.apple.dock autohide-time-modifier -float 0

# Automatically hide and show the Dock
defaults write com.apple.dock autohide -bool true

# Make Dock icons of hidden applications translucent
defaults write com.apple.dock showhidden -bool true

# Don’t show recent applications in Dock
defaults write com.apple.dock show-recents -bool false

###############################################################################
# Finder                                                                      #
###############################################################################

# Set $HOME as the default location for new Finder windows. "PfHm" is Finder's
# code for the home folder; the path below is what it actually opens.
defaults write com.apple.finder NewWindowTarget -string "PfHm"
defaults write com.apple.finder NewWindowTargetPath -string "file://${HOME}"

# Finder: show status bar
defaults write com.apple.finder ShowStatusBar -bool true

# Finder: show path bar
defaults write com.apple.finder ShowPathbar -bool true

# Keep folders on top when sorting by name
defaults write com.apple.finder _FXSortFoldersFirst -bool true

# Search the current folder by default rather than the whole Mac ("SCev" is
# this Mac, "SCsp" the previous scope, "SCcf" the current folder).
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"

# Avoid creating .DS_Store files on network or USB volumes
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# Use list view in all Finder windows by default. Four-character view codes:
# "Nlsv" list, "icnv" icon, "clmv" column, "Flwv" gallery.
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"

###############################################################################
# Terminal                                                                    #
###############################################################################

# Only use UTF-8 in Terminal.app. The domain is really com.apple.Terminal, but
# `defaults` matches domains case-insensitively, so this does land correctly.
defaults write com.apple.terminal StringEncodings -array 4

# Enable Secure Keyboard Entry in Terminal.app
# See: https://security.stackexchange.com/a/47786/8918
#
# Terminal rewrites its own preferences when it quits, so this only sticks if
# Terminal is not running when it is applied -- otherwise it gets overwritten
# and has to be set from Terminal's own menu instead.
defaults write com.apple.terminal SecureKeyboardEntry -bool true

# Use Gotham theme by default in Terminal.app.
#
# Only attempted from a real desktop session. AppleScript that drives a GUI app
# cannot work over ssh or from a headless machine: the AppleEvent has nothing to
# talk to and blocks until it times out. On a real machine the first run also
# needs Automation consent, which macOS prompts for.
if [ "$(launchctl managername 2>/dev/null)" != "Aqua" ]; then
	echo "Skipping the Terminal theme: not a desktop session"
else
osascript <<EOD
tell application "Terminal"
	local allOpenedWindows
	local initialOpenedWindows
	local windowID
	set themeName to "Gotham"
	(* Store the IDs of all the open terminal windows. *)
	set initialOpenedWindows to id of every window
	(* Open the custom theme so that it gets added to the list
	   of available terminal themes (note: this will open two
	   additional terminal windows). *)
	do shell script "open '$HOME/.dotfiles/script/init/" & themeName & ".terminal'"
	(* Wait a little bit to ensure that the custom theme is added. *)
	delay 1
	(* Set the custom theme as the default terminal theme. *)
	set default settings to settings set themeName
	(* Get the IDs of all the currently opened terminal windows. *)
	set allOpenedWindows to id of every window
	repeat with windowID in allOpenedWindows
		(* Close the additional windows that were opened in order
		   to add the custom theme to the list of terminal themes. *)
		if initialOpenedWindows does not contain windowID then
			close (every window whose id is windowID)
		(* Change the theme for the initial opened terminal windows
		   to remove the need to close them in order for the custom
		   theme to be applied. *)
		else
			set current settings of tabs of (every window whose id is windowID) to settings set themeName
		end if
	end repeat
end tell
EOD
fi

# Restart the apps that own the settings above, so the (relaunch) ones take
# effect now. SystemUIServer still exists, though most of the menu bar it used
# to own now belongs to ControlCenter.
for app in \
	"Dock" \
	"Finder" \
	"SystemUIServer" \
  ; do
	killall "${app}" &> /dev/null
done
echo "Done. Note that some of these changes require a logout/restart to take effect."
