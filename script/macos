#!/usr/bin/env bash
#
# macOS system settings. Run by script/bootstrap on a new machine, and safe to
# re-run afterwards -- every change is a `defaults write`, so it is idempotent.
#
#   script/macos                apply the settings
#   script/macos --check        report which are not applied, change nothing
#   script/macos --reset-dock   also clear the Dock's pinned icons
#
# The settings live in one table, so applying them, checking them and testing
# them are the same list -- CI runs --check after applying, which is why nothing
# needs a hand-maintained copy of the expected values.
#
# The login shell is no longer set here: it moved to script/bootstrap, which runs
# after the Brewfile has installed the shell it points at.
#
# Deliberately no `set -e`: a key a future macOS stops honouring should not stop
# the rest from applying. Failures are counted and reported rather than passing
# silently.
#
# Two things worth knowing before re-running on a machine you have since set up
# by hand:
#
#   - the Dock's icons are wiped, but only with --reset-dock
#
# Settings marked (relaunch) need the owning app restarted, which the killall at
# the bottom handles. Settings marked (logout) need a full logout or restart.


CHECK_ONLY=""
RESET_DOCK=""
for arg in "$@"; do
	case "$arg" in
		--check)      CHECK_ONLY="1" ;;
		--reset-dock) RESET_DOCK="1" ;;
		*) echo "!!! unknown option: $arg" >&2; exit 1 ;;
	esac
done

# Close System Settings, so an open pane cannot write its cached values back
# over what we are about to change. Called "System Preferences" until Ventura
# renamed it; the old name no longer resolves to anything.
osascript -e 'tell application "System Settings" to quit' 2>/dev/null

###############################################################################
# Record what was here first                                                  #
###############################################################################

# Whole domains, not individual keys: putting a key back means knowing its type,
# and several of these are arrays. `defaults export` captures everything and
# `defaults import` puts it back.
#
# First run only, deliberately. Running this again once the settings have been
# applied would record the changed values as though they were the originals, and
# quietly destroy the only copy of what the machine used to look like.
BACKUP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/macos-defaults"
TOUCHED_DOMAINS=(
	NSGlobalDomain
	com.apple.print.PrintingPrefs
	com.apple.dock
	com.apple.finder
	com.apple.desktopservices
	com.apple.Terminal
)

if [ -n "$CHECK_ONLY" ]; then
	: # --check changes nothing, including this
elif [ -d "$BACKUP_DIR" ]; then
	echo "Previous values already recorded in $BACKUP_DIR"
else
	echo "Recording the current values in $BACKUP_DIR:"
	mkdir -p "$BACKUP_DIR"
	for domain in "${TOUCHED_DOMAINS[@]}"; do
		if defaults export "$domain" "$BACKUP_DIR/$domain.plist" 2>/dev/null; then
			echo "  $domain"
		else
			echo "  $domain (not set on this machine)"
		fi
	done
	dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}' \
		> "$BACKUP_DIR/login-shell"

	# A directory of plists is not much use on its own, so write the thing that
	# actually puts them back.
	{
		echo "#!/usr/bin/env bash"
		echo "#"
		echo "# Restore the values this machine had before script/macos first ran."
		echo "# Recorded $(date '+%Y-%m-%d %H:%M:%S %z')."
		echo "#"
		echo "# Log out afterwards: some of these only take effect on login."
		echo "set -eu"
		echo 'cd "$(dirname "$0")"'
		for domain in "${TOUCHED_DOMAINS[@]}"; do
			if [ -f "$BACKUP_DIR/$domain.plist" ]; then
				echo "defaults import $domain ./$domain.plist"
			else
				echo "defaults delete $domain 2>/dev/null || true  # was not set before"
			fi
		done
		echo 'sudo chsh -s "$(cat ./login-shell)" "$USER"'
		echo 'killall Dock Finder SystemUIServer 2>/dev/null || true'
		echo 'echo "Restored. Log out for the rest to take effect."'
	} > "$BACKUP_DIR/restore"
	chmod +x "$BACKUP_DIR/restore"
	echo "  wrote $BACKUP_DIR/restore"
fi


###############################################################################
# The settings                                                                #
###############################################################################

# domain|key|type|value|when|what it does
#
# "when" is when it takes effect: now, relaunch (of the owning app, which the
# killall at the bottom handles), or logout.
SETTINGS=(
	"NSGlobalDomain|AppleInterfaceStyle|-string|Dark|logout|Dark mode"
	"NSGlobalDomain|NSNavPanelExpandedStateForSaveMode|-bool|true|now|Expanded save panel"
	"NSGlobalDomain|NSNavPanelExpandedStateForSaveMode2|-bool|true|now|Expanded save panel"
	"NSGlobalDomain|PMPrintingExpandedStateForPrint|-bool|true|now|Expanded print panel"
	"NSGlobalDomain|PMPrintingExpandedStateForPrint2|-bool|true|now|Expanded print panel"
	"com.apple.print.PrintingPrefs|Quit When Finished|-bool|true|now|Quit the printer app when done"

	"com.apple.dock|tilesize|-int|48|relaunch|Icon size"
	"com.apple.dock|orientation|-string|right|relaunch|Dock on the right"
	"com.apple.dock|autohide|-bool|true|relaunch|Auto-hide"
	"com.apple.dock|autohide-delay|-float|0|relaunch|No delay before showing"
	"com.apple.dock|autohide-time-modifier|-float|0|relaunch|No hide and show animation"
	"com.apple.dock|showhidden|-bool|true|relaunch|Dim hidden apps"
	"com.apple.dock|show-recents|-bool|false|relaunch|No recent applications"

	"com.apple.finder|NewWindowTarget|-string|PfHm|relaunch|New windows open at home (PfHm)"
	"com.apple.finder|NewWindowTargetPath|-string|file://${HOME}|relaunch|...which is this path"
	"com.apple.finder|ShowStatusBar|-bool|true|relaunch|Status bar"
	"com.apple.finder|ShowPathbar|-bool|true|relaunch|Path bar"
	"com.apple.finder|_FXSortFoldersFirst|-bool|true|relaunch|Folders first when sorting"
	"com.apple.finder|FXDefaultSearchScope|-string|SCcf|relaunch|Search the current folder (SCcf; SCev is this Mac)"
	"com.apple.finder|FXPreferredViewStyle|-string|Nlsv|relaunch|List view (Nlsv; icnv, clmv, Flwv are the others)"

	"com.apple.desktopservices|DSDontWriteNetworkStores|-bool|true|logout|No .DS_Store on network volumes"
	"com.apple.desktopservices|DSDontWriteUSBStores|-bool|true|logout|No .DS_Store on USB volumes"

	"com.apple.Terminal|StringEncodings|-array|4|relaunch|UTF-8 only"
)

# What `defaults read` gives back for a value, so what is wanted can be compared
# with what is there instead of writing blindly every time.
as_read() {
	case "$1" in
		-bool)  case "$2" in true|yes|1) echo 1 ;; *) echo 0 ;; esac ;;
		-array) echo "($2)" ;;
		*)      echo "$2" ;;
	esac
}

applied=0
changed=0
failed=0
drifted=0

for setting in "${SETTINGS[@]}"; do
	IFS="|" read -r domain key type value when what <<< "$setting"
	# a couple of values mention $HOME
	value="$(eval echo "\"$value\"")"

	want="$(as_read "$type" "$value" | tr -d '[:space:]')"
	have="$(defaults read "$domain" "$key" 2>/dev/null | tr -d '[:space:]')"

	if [ "$want" = "$have" ]; then
		applied=$((applied + 1))
		continue
	fi

	if [ -n "$CHECK_ONLY" ]; then
		drifted=$((drifted + 1))
		printf '  not applied: %s %s is %s, wanted %s (%s)\n' \
			"$domain" "$key" "${have:-unset}" "$want" "$what"
		continue
	fi

	if defaults write "$domain" "$key" "$type" "$value" 2>/dev/null; then
		changed=$((changed + 1))
		printf '  %s (%s)\n' "$what" "$when"
	else
		failed=$((failed + 1))
		printf '  FAILED: %s %s -- macOS may no longer honour it\n' "$domain" "$key"
	fi
done

if [ -n "$CHECK_ONLY" ]; then
	echo "$applied of ${#SETTINGS[@]} settings applied, $drifted not"
	[ "$drifted" -eq 0 ] || exit 1
	exit 0
fi

echo "$changed changed, $applied already applied, $failed failed"

###############################################################################
# The Dock's pinned icons                                                     #
###############################################################################

# Not in the table because it is destructive rather than declarative: it clears
# whatever you have pinned since. Opt in, because re-running bootstrap is cheap
# now and losing the Dock every time is not a fair price for that.
if [ -n "$RESET_DOCK" ]; then
	echo "Clearing the Dock's pinned icons"
	defaults write com.apple.dock persistent-apps -array
fi

# Use the Gotham profile in Terminal.app.
#
# Terminal registers a .terminal file when it is opened, so `open` is enough. No
# AppleScript means no Automation consent prompt, and none of the window juggling
# the old version needed -- it opened two windows to import the profile and then
# closed them again. Skipped entirely when the profile is already installed, so a
# re-run opens nothing.
THEME_NAME="Gotham"
THEME_FILE="$(cd "$(dirname "$0")" && pwd -P)/init/$THEME_NAME.terminal"

profile_installed() {
	defaults read com.apple.Terminal "Window Settings" 2>/dev/null \
		| grep -qE "^[[:space:]]+\"?$THEME_NAME\"? ="
}

if [ "$(launchctl managername 2>/dev/null)" != "Aqua" ]; then
	echo "Skipping the Terminal profile: not a desktop session"
elif [ ! -f "$THEME_FILE" ]; then
	echo "Skipping the Terminal profile: $THEME_FILE is missing"
else
	if profile_installed; then
		echo "Terminal profile $THEME_NAME is already installed"
	else
		echo "Installing the $THEME_NAME Terminal profile:"
		open -g "$THEME_FILE"
		# Wait for Terminal to register it, rather than sleeping a fixed second
		# and hoping.
		for _ in $(seq 1 40); do
			profile_installed && break
			sleep 0.25
		done
		profile_installed || echo "  (Terminal did not register it; open $THEME_FILE by hand)"
	fi

	defaults write com.apple.Terminal "Default Window Settings" -string "$THEME_NAME"
	defaults write com.apple.Terminal "Startup Window Settings" -string "$THEME_NAME"
fi

# Restart the apps that own the settings above, so the (relaunch) ones take
# effect now. SystemUIServer still exists, though most of the menu bar it used
# to own now belongs to ControlCenter.
for app in \
	"Dock" \
	"Finder" \
	"SystemUIServer" \
  ; do
	killall "${app}" &> /dev/null
done
echo "Done. Note that some of these changes require a logout/restart to take effect."
