#!/usr/bin/env bash
#
# Checks the things that rot quietly: packages that upstream has deprecated or
# renamed, plugin repositories that have been archived, and tools the shell
# config invokes but no Brewfile installs. All of it was done by hand once; this
# is that afternoon, written down.
#
# Exits non-zero when something needs attention. Sections that cannot run say so
# rather than passing silently.

set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

FAILURES=0
WARNINGS=0
SKIPPED=""
STALE_AFTER_MONTHS=24

fail() { printf '  FAIL  %s\n' "$1"; FAILURES=$((FAILURES + 1)); }
warn() { printf '  warn  %s\n' "$1"; WARNINGS=$((WARNINGS + 1)); }
ok()   { printf '  ok    %s\n' "$1"; }
head2() { printf '\n== %s\n' "$1"; }

# ---------------------------------------------------------------- brew packages

head2 "Brewfile packages"
if ! command -v brew >/dev/null 2>&1; then
  SKIPPED="$SKIPPED brew"
  printf '  ----  not checked: brew is not installed\n'
else
  while read -r kind name; do
    [ -n "$name" ] || continue
    case "$kind" in
      brew) flag="--formula"; key=".formulae[0]" ;;
      cask) flag="--cask";    key=".casks[0]" ;;
      *) continue ;;
    esac
    json="$(brew info --json=v2 "$flag" "$name" 2>/dev/null)"
    if [ -z "$json" ]; then
      fail "$kind '$name' no longer resolves"
      continue
    fi
    read -r token deprecated disabled reason <<EOF
$(printf '%s' "$json" | jq -r "$key | [(.token // .name), (.deprecated|tostring), (.disabled|tostring), (.deprecation_reason // \"-\")] | @tsv")
EOF
    if [ "$disabled" = true ]; then
      fail "$kind '$name' is disabled upstream"
    elif [ "$deprecated" = true ]; then
      fail "$kind '$name' is deprecated upstream ($reason)"
    elif [ -n "$token" ] && [ "$token" != "$name" ]; then
      fail "$kind '$name' was renamed to '$token'"
    else
      ok "$kind '$name'"
    fi
  done <<EOF
$(grep -E "^(brew|cask) '" Brewfile | tr -d "'" )
EOF

  while read -r _ tap; do
    [ -n "$tap" ] || continue
    if brew tap-info "$tap" >/dev/null 2>&1; then ok "tap '$tap'"; else fail "tap '$tap' does not resolve"; fi
  done <<EOF
$(grep -E "^tap '" Brewfile | tr -d "'")
EOF
fi

# ------------------------------------------------------------- plugin upstreams

head2 "Plugin and framework upstreams"
if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
  SKIPPED="$SKIPPED github"
  printf '  ----  not checked: gh is unavailable or not authenticated\n'
else
  cutoff="$(date -v-${STALE_AFTER_MONTHS}m +%Y-%m-%d 2>/dev/null || date -d "-${STALE_AFTER_MONTHS} months" +%Y-%m-%d)"
  {
    grep -rhoE "zinit (light|load) [A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+" config/zsh | awk '{print $3}'
    grep -rhoE "https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\.git" config/zsh \
      | sed -e 's|https://github.com/||' -e 's|\.git$||'
    grep -rqE "PZTM::|PZT::" config/zsh && echo "sorin-ionescu/prezto"
  } | sort -u | while read -r repo; do
    [ -n "$repo" ] || continue
    info="$(gh api "repos/$repo" --jq '[(.archived|tostring), .pushed_at[0:10]] | @tsv' 2>/dev/null)"
    if [ -z "$info" ]; then
      echo "FAIL|$repo no longer resolves on GitHub"
      continue
    fi
    archived="$(printf '%s' "$info" | cut -f1)"
    pushed="$(printf '%s' "$info" | cut -f2)"
    if [ "$archived" = true ]; then
      echo "FAIL|$repo is archived upstream"
    elif [ "$pushed" \< "$cutoff" ]; then
      echo "WARN|$repo has had no push since $pushed"
    else
      echo "OK|$repo ($pushed)"
    fi
  done > /tmp/audit-upstreams.$$
  while IFS='|' read -r verdict message; do
    case "$verdict" in
      FAIL) fail "$message" ;;
      WARN) warn "$message" ;;
      OK)   ok "$message" ;;
    esac
  done < /tmp/audit-upstreams.$$
  rm -f /tmp/audit-upstreams.$$
fi

# ----------------------------------------------------- declared-dependency drift

head2 "Tools the config invokes but the Brewfile does not install"
# Only command positions that can be read mechanically, so this does not guess:
# the fzf command variables, cached_init/cached_completion, git's pager, and
# alias targets. That set is what produced the one real bug here -- fzf calling
# an rg that nothing installed.
# Comment lines are dropped first: prose mentioning cached_init or a command
# name is not an invocation, and reading it as one is how this reported that the
# config depends on a tool called "deliberately".
strip_comments() { grep -vE "^[[:space:]]*#"; }
{
  grep -rh "FZF_" config/zsh | strip_comments \
    | grep -oE "FZF_[A-Z_]*COMMAND='[a-z0-9_-]+" | sed "s/.*='//"
  grep -rh -E "cached_(init|completion) " config/zsh | strip_comments \
    | grep -oE "cached_(init|completion) [a-z0-9_-]+ [a-z0-9_-]+" | awk '{print $3}'
  grep -h "pager = " config/git/config | strip_comments \
    | grep -oE "pager = [a-z0-9_-]+" | awk '{print $3}'
  grep -h -E "^[[:space:]]*alias " config/zsh/lib/alias.zsh | strip_comments \
    | grep -oE "alias [a-zA-Z0-9_-]+='?[a-z0-9_-]+" | sed -E "s/.*='?//"
} 2>/dev/null | sort -u | while read -r tool; do
  [ -n "$tool" ] || continue
  grep -qE "^(brew|cask) '$tool'" Brewfile && continue
  # formula name and binary name differ often enough to check the obvious cases
  case "$tool" in
    nvim) grep -q "^brew 'neovim'" Brewfile && continue ;;
    rg)   grep -q "^brew 'ripgrep'" Brewfile && continue ;;
    op)   grep -q "^cask '1password-cli'" Brewfile && continue ;;
    docker) grep -q "^cask 'docker-desktop'" Brewfile && continue ;;
  esac
  for d in /usr/bin /bin /usr/sbin /sbin; do
    [ -x "$d/$tool" ] && continue 2
  done
  echo "$tool"
done > /tmp/audit-drift.$$
if [ -s /tmp/audit-drift.$$ ]; then
  while read -r tool; do
    fail "'$tool' is invoked by config/ but is in neither the Brewfile nor the base system"
  done < /tmp/audit-drift.$$
else
  ok "every tool the config names is installed by something"
fi
rm -f /tmp/audit-drift.$$

# ------------------------------------------------------------------------ result

printf '\n== Summary\n'
printf '  %s failures, %s warnings\n' "$FAILURES" "$WARNINGS"
[ -z "$SKIPPED" ] || printf '  NOT CHECKED:%s\n' "$SKIPPED"
[ "$FAILURES" -eq 0 ] || exit 1
exit 0
