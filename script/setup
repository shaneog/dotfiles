#!/usr/bin/env bash
#
# Install the dotfiles into the home directory.
#
# Four things in the clone are linked, and they are named at the foot of this
# script: Brewfile, config, ssh and claude. Brewfile becomes ~/.Brewfile. config
# and ssh become real directories -- ~/.config and ~/.ssh -- holding one link
# for each entry git tracks directly beneath them: ~/.config/nvim,
# ~/.config/zsh, ~/.ssh/config. Everything else in those directories belongs to
# whichever tool wrote it, and stays outside the clone, where deleting or
# publishing the repo cannot reach it.
#
# claude is Claude Code's ~/.claude, linked one level further down: a file is
# one link, ~/.claude/settings.json, and a folder is a real folder holding a
# link for each entry, ~/.claude/skills/<name>.
#
# Anything already at a target path is moved aside rather than deleted, except
# in ~/.claude, where it is left as it is. The externally managed shell files
# -- ~/.profile, ~/.bashrc, ~/.zprofile, ~/.zshrc -- are never touched: they are
# sourced as a base layer from ours instead.
set -euo pipefail

DOTFILESDIRREL="$(dirname "$0")"
cd "$DOTFILESDIRREL"/.. || exit
DOTFILESDIR=$(pwd -P)

# One stamp for the whole run, so everything moved aside by it sorts together.
STAMP="$(date +%Y%m%d%H%M%S)"

abort() { echo "!!! $*" >&2; exit 1; }

# Back up rather than delete: on any machine that has been used, the target
# paths already hold something, and it may be the only copy.
move_aside() {  # path
  mv -v "$1" "$1.bak.$STAMP"
}

link_into() {  # target in the clone, link path
  if [ -L "$2" ] && [ "$2" -ef "$1" ]
  then
    echo "$2 == $1 (unchanged)"
    return 0
  fi
  if [ -e "$2" ] || [ -L "$2" ]
  then
    move_aside "$2"
  fi
  ln -sv "$1" "$2"
}

# The entries git tracks directly under one of the clone's directories. The
# index is the list of what is ours: a tool's state that turned up beside our
# files is not in it, and neither is a directory nobody has `git add`ed yet.
tracked_entries() {  # directory, relative to the clone
  local path
  git -C "$DOTFILESDIR" ls-files -- "$1" | while IFS= read -r path
  do
    path="${path#"$1"/}"
    echo "${path%%/*}"
  done | sort -u
}

# Earlier versions of this script linked ~/.config and ~/.ssh to the clone's
# whole directories, so every tool that wrote under them wrote into the clone.
# Hand those files back: move what git does not track out to a real directory,
# then put that directory where the link was. The staging name is fixed, so a
# run that was interrupted is picked up where it stopped.
unlink_whole_directory() {  # directory in the clone, its link in $HOME, tracked entries
  local staging="$2.migrating" entry name
  echo "$2 is a link to the whole of $1, moving other tools' files out of the clone"
  mkdir -p "$staging"
  for entry in "$1"/* "$1"/.[!.]* "$1"/..?*
  do
    # an unmatched pattern is left as it was written
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    name="${entry##*/}"
    if printf '%s\n' "$3" | grep -qxF -- "$name"
    then
      continue
    fi
    if [ -e "$staging/$name" ] || [ -L "$staging/$name" ]
    then
      move_aside "$staging/$name"
    fi
    mv -v "$entry" "$staging/$name"
  done
  rm "$2"
  mv "$staging" "$2"
}

link_directory() {  # top-level directory name
  local source="$DOTFILESDIR/$1" target="$HOME/.$1" entries entry created=""

  entries="$(tracked_entries "$1")"
  [ -n "$entries" ] || abort "git tracks nothing under $source, so there is nothing to link"

  if [ -L "$target" ] && [ "$target" -ef "$source" ]
  then
    unlink_whole_directory "$source" "$target" "$entries"
    created=1
  else
    # Never take over the files in an ~/.ssh that holds a private key. Where
    # something else manages ssh -- a corporate setup, say -- its config is
    # what names that key, and moving it aside breaks authentication until it
    # is put back.
    if [ "$1" = "ssh" ] && ls "$target"/id_* >/dev/null 2>&1
    then
      echo "$target holds a private key and is managed elsewhere, leaving it alone"
      return 0
    fi

    if [ ! -d "$target" ]
    then
      if [ -e "$target" ] || [ -L "$target" ]
      then
        move_aside "$target"
      fi
      mkdir -p "$target"
      created=1
    fi
  fi

  # Only on a directory made here: the mode of one that was already there is
  # somebody's decision.
  if [ -n "$created" ] && [ "$1" = "ssh" ]
  then
    chmod 700 "$target"
  fi

  while IFS= read -r entry
  do
    link_into "$source/$entry" "$target/$entry"
  done <<< "$entries"
}

# In ~/.claude a name that is taken stays taken. Claude Code writes its own
# settings.json and has no second file to read for one machine, so a machine
# that needs settings of its own has to be able to keep them, and one that was
# moved aside would be moved aside again on the next run. The same goes for a
# skill or an agent a machine already has under a name of ours. The repo's copy
# is used once the machine's is out of the way.
link_beside() {  # target in the clone, link path
  if [ -L "$2" ] && [ "$2" -ef "$1" ]
  then
    echo "$2 == $1 (unchanged)"
    return 0
  fi
  if [ -e "$2" ]
  then
    echo "$2 is this machine's own, leaving it alone (move it aside and run this again to use the repo's)"
    return 0
  fi
  # What is left is a link that leads nowhere, which holds nothing to keep.
  if [ -L "$2" ]; then rm "$2"; fi
  ln -sv "$1" "$2"
}

# ~/.claude holds what Claude Code reads beside what it writes: its sessions,
# its history, the plugins it installed. So the directory is never a link, and
# neither are the folders in it. A skill written on one machine, for an
# employer's work say, sits beside ours as a real folder and never reaches the
# clone.
link_claude() {
  local source="$DOTFILESDIR/claude" target="$HOME/.claude" entry inner
  [ -d "$source" ] || return 0

  if [ -e "$target" ] && [ ! -d "$target" ]
  then
    echo "$target is not a folder, so nothing is linked into it"
    return 0
  fi
  mkdir -p "$target"
  while IFS= read -r entry
  do
    [ -n "$entry" ] || continue
    if [ ! -d "$source/$entry" ]
    then
      link_beside "$source/$entry" "$target/$entry"
      continue
    fi
    if [ -e "$target/$entry" ] && [ ! -d "$target/$entry" ]
    then
      echo "$target/$entry is not a folder, so nothing is linked into it"
      continue
    fi
    mkdir -p "$target/$entry"
    while IFS= read -r inner
    do
      [ -n "$inner" ] || continue
      link_beside "$source/$entry/$inner" "$target/$entry/$inner"
    done <<< "$(tracked_entries "claude/$entry")"
  done <<< "$(tracked_entries claude)"
}

# What reaches $HOME, by name. Everything else at the top of the clone is the
# repo's own -- scripts, tests, guides, whatever is added next -- and a script
# that writes into $HOME should not pick it up by default. A new top-level
# dotfile needs a line here.
link_into "$DOTFILESDIR/Brewfile" "$HOME/.Brewfile"
link_directory config
link_directory ssh
link_claude

# .zshenv is the entry point that sets ZDOTDIR, and the only home-level shell
# file we own. Where something else already manages ~/.profile, ~/.bashrc,
# ~/.zprofile and ~/.zshrc, those are sourced as a base layer from our own
# .zprofile/.zshrc rather than replaced.
link_into "$DOTFILESDIR/config/zsh/.zshenv" "$HOME/.zshenv"

# Set up ssh/config-local, if it doesn't exist
if [ ! -f "$HOME/.ssh/config-local" ]; then
  echo "# Machine specific SSH config file" > "$HOME/.ssh/config-local"
fi
