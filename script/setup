#!/usr/bin/env bash
# Install all dotfiles into the home directory

DOTFILESDIRREL="$(dirname "$0")"
cd "$DOTFILESDIRREL"/.. || exit
DOTFILESDIR=$(pwd -P)

[ "$(uname -s)" = "Darwin" ] && export OSX=1 && export UNIX=1
[ "$(uname -s)" = "Linux" ] && export LINUX=1 && export UNIX=1

for DOTFILE in *; do
  HOMEFILE="$HOME/.$DOTFILE"
  [ -d "$DOTFILE" ] && DOTFILE="$DOTFILE/"
  DIRFILE="$DOTFILESDIR/$DOTFILE"

  # shellcheck disable=SC2196
  echo "$DOTFILE" | egrep -q '(^script/$|\.txt$|\.md$)' && continue

  # shellcheck disable=SC2001
  echo "$DOTFILE" | grep -q '\.sh' \
    && HOMEFILE="$HOME/.$(echo "$DOTFILE" | sed -e 's/\.sh//')"

  # Already pointing into the repo: leave it be, rather than `rm -r` a live
  # directory (~/.config in particular, which other tools write into too)
  if [ -L "$HOMEFILE" ] && [ "$HOMEFILE" -ef "$DIRFILE" ]
  then
    echo "$HOMEFILE == $DIRFILE (unchanged)"
    continue
  fi

  if [ $UNIX ]
  then
    if [ -L "$HOMEFILE" ] && ! [ -d "$DOTFILE" ]
    then
      ln -sfv "$DIRFILE" "$HOMEFILE"
    else
      rm -rv "$HOMEFILE"
      ln -sv "$DIRFILE" "$HOMEFILE"
    fi
  else
    cp -rv "$DIRFILE" "$HOMEFILE"
  fi
done

# Symlink .zshenv. This is the entry point that sets ZDOTDIR, and the only
# home-level shell file we own. Where something else already manages
# ~/.profile, ~/.bashrc, ~/.zprofile and ~/.zshrc, those are sourced as a base
# layer from our own .zprofile/.zshrc rather than replaced.
if [ -e "$HOME/.zshenv" ] && [ ! -L "$HOME/.zshenv" ]
then
  mv -v "$HOME/.zshenv" "$HOME/.zshenv.bak.$(date +%Y%m%d%H%M%S)"
fi
ln -sfv "$HOME/.config/zsh/.zshenv" "$HOME/.zshenv"

# Set up ssh/config-local, if it doesn't exist
if [ ! -f "$HOME/.ssh/config-local" ]; then
  echo "# Machine specific SSH config file" > "$HOME/.ssh/config-local"
fi

