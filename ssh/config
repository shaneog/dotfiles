# Machine-specific overrides go first: ssh keeps the first value it sees for
# each keyword, so an include below this point could only add settings, never
# override them.
Include ~/.ssh/config-local

# Do not kill connection if route is down temporarily.
TCPKeepAlive no

# Allow 5 minutes down time before giving up the connection.
ServerAliveCountMax 10
ServerAliveInterval 30

# Conserve bandwith. (Compression is off by default.)
Compression yes

# Inside an inbound ssh session, defer to whatever the environment says the
# agent is -- normally an agent the client forwarded. IdentityAgent overrides
# SSH_AUTH_SOCK, so without this the Host * setting below would point onward
# hops at 1Password's socket and wait for an approval nobody is there to give.
# lib/1password.zsh declines to export the variable in the same situation.
# The literal string SSH_AUTH_SOCK tells ssh to read it from the environment.
Match exec "test -n \"$SSH_CONNECTION\""
    IdentityAgent SSH_AUTH_SOCK

Host *
    SendEnv LS_COLORS

    # Keys live in 1Password, never on disk, so authentication goes through its
    # agent for every host. The path is the same on every Mac, and the setting is
    # inert when 1Password is not installed.
    #
    # AddKeysToAgent and UseKeychain used to be here. Both are about on-disk keys
    # and passphrases in the Apple keychain, which is the model this replaces.
    #
    # IdentitiesOnly is deliberately left alone: setting it would restrict
    # authentication to keys named by IdentityFile, and there are none.
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

    ControlMaster auto
    ControlPath /tmp/ssh-%r@%h:%p.socket
    NoHostAuthenticationForLocalhost yes
    StrictHostKeyChecking ask
    VerifyHostKeyDNS ask
