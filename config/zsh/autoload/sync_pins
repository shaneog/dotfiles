# Move whatever is installed to the commit pins.zsh names for it.
#
# zinit applies `ver` only when it first clones a plugin, and downloads a
# snippet only when it has no copy. Left to itself, a changed pin would reach
# new machines and no others.
#
# A shell with nothing to move pays one small file read per pin and starts no
# process: a checkout made at a commit records that commit in .git/HEAD.

emulate -L zsh
local home=${ZINIT[ZINIT_HOME]:h} repo want dir
[[ -n $home ]] || return 0

for repo want in "${(@kv)DOTFILES_PINS}"; do
  case $repo in
    zdharma-continuum/zinit) dir=$ZINIT[ZINIT_HOME] ;;
    # Not a checkout: see below.
    sorin-ionescu/prezto)    continue ;;
    *)                       dir=$home/plugins/${repo//\//---} ;;
  esac
  # Not installed yet, so zinit is about to clone it, at the pin.
  [[ -r $dir/.git/HEAD ]] || continue
  [[ "$(<$dir/.git/HEAD)" == $want ]] && continue

  print -r -- "Moving $repo to its pinned commit ${want[1,7]}..."
  # Fetched only when the commit is not already there, so going back to an
  # older pin needs no network.
  { git -C $dir cat-file -e "${want}^{commit}" 2>/dev/null \
      || git -C $dir fetch -q origin $want } \
    && git -C $dir checkout -q --detach $want \
    || print -ru2 -- "Could not move $repo to ${want[1,7]}: still running the commit that was installed."
done

# Prezto's modules are single files, which zinit names after the module and not
# after where they came from. The commit they were downloaded at is recorded
# beside them, and when the pin moves on they are deleted to be fetched again.
local stamp=$home/snippets/.prezto-commit have=
want=$DOTFILES_PINS[sorin-ionescu/prezto]
[[ -r $stamp ]] && have="$(<$stamp)"
if [[ -n $want && $have != $want ]]; then
  mkdir -p $home/snippets
  rm -rf $home/snippets/PZT*(N)
  print -r -- $want > $stamp
fi
