# Cache a tool's shell-integration script, so startup neither shells out to
# generate it nor downloads the tool to begin with. The binaries come from the
# Brewfile; only the wiring lives in this repo.
#
# Sets $REPLY to the cached file and returns 0, so callers can do:
#
#   cached_init starship starship init zsh && source $REPLY
#
# Returns non-zero (and leaves $REPLY empty) when the tool is not installed, so
# a missing tool is a no-op rather than an error.
#
# usage: cached_init <name> <command> [args...]

emulate -L zsh
setopt local_options

local name=$1; shift
local bin=${commands[$1]}
REPLY=

[[ -n $bin ]] || return 1

local dir=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init
local file=$dir/$name.zsh

# The cache opens with the binary it came from, symlinks resolved. Homebrew
# keeps each version in a directory of its own and stamps the binary with the
# date of the upstream source, not of the install, so a newer version can be
# older than the cache: the path changing is what says it was upgraded. -nt
# covers a tool replaced in place, which keeps its path.
local stamp="# from ${bin:A}" first=
[[ -s $file ]] && IFS= read -r first < $file

# Regenerate when missing, empty, from another binary, or older than the binary,
# so an upgraded tool refreshes its own integration.
if [[ $first != $stamp || $bin -nt $file ]]; then
  mkdir -p $dir || return 1
  # An empty init script is worse than none, so exit status alone is not enough.
  local out
  out="$("$@" 2>/dev/null)" && [[ -n $out ]] || return 1
  # Write via a temporary file: a reader must never see a half-written script,
  # and a failed write must not leave a broken cache behind.
  local tmp=$file.$$
  if ! print -r -- "$stamp"$'\n'"$out" > $tmp; then
    rm -f $tmp
    return 1
  fi
  mv -f $tmp $file || return 1
fi

REPLY=$file
